PROJECT_BRIEF          = "Program ma na celu pomoc przy projektowaniu infrastruktury sieciowej dla firm."
OUTPUT_LANGUAGE        = Polish
OUTPUT_DIRECTORY       = docs

INPUT                  = README.md \
                         src/core \
                         src/llm \
                         src/storage \
                         src/gui \
                         tests

USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h

